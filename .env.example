NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=2048
HOST=127.0.0.1
PORT=3016

# Use a separate secret in production. Chibox sends this as apiToken.
SCRAPER_API_TOKEN=change-me

# One scrape exclusively leases one browser, so keep these equal.
BROWSER_POOL_SIZE=8
BROWSER_WARM_SIZE=8
BROWSER_ACQUIRE_TIMEOUT_MS=10000
MAX_CONCURRENT=8
MAX_QUEUE=64
MAX_SERIAL_WAITERS=64
MAX_SERIAL_WAITERS_PER_KEY=16
QUEUE_TIMEOUT_MS=15000

REQUEST_TIMEOUT_MS=40000
ITEM_SCRAPE_TIMEOUT_MS=34000
ITEM_HTTP_TIMEOUT_MS=3500
# Total budget for the anonymous mobile HTML + signed MTop detail fallback.
MTOP_DETAIL_BUDGET_MS=14000
# Proxy-first shop item/info and category request budgets.
SHOP_HTTP_BUDGET_MS=14000
SHOP_CATEGORY_HTTP_BUDGET_MS=20000
SEARCH_TIMEOUT_MS=34000
SEARCH_ATTEMPTS=1
TRANSLATE_TIMEOUT_MS=5000
TRANSLATE_CONCURRENCY=3
CATEGORY_PAGE_CONCURRENCY=3
CATEGORY_MERGE_TTL_MS=120000
CATEGORY_MERGE_MAX_STATES=24
CATEGORY_MERGE_MAX_RESULTS=1000
CATEGORY_MAX_UPSTREAM_PAGES=30
MAX_BODY_BYTES=65536
MAX_CONTEXT_BYTES=12000000

ITEM_CACHE_TTL_MS=1800000
SEARCH_CACHE_TTL_MS=120000
LIST_CACHE_TTL_MS=600000
META_CACHE_TTL_MS=21600000
CACHE_MAX_ENTRIES=2000
DISK_CACHE=1
DISK_CACHE_TTL_MS=21600000
DISK_CACHE_MAX_FILES=5000
DISK_CACHE_MAX_BYTES=536870912
DISK_CACHE_MAX_AGE_MS=86400000
DISK_CACHE_PRUNE_INTERVAL_MS=60000
DISK_CACHE_TEMP_MAX_AGE_MS=600000
CACHE_DIR=/var/lib/1688-scraper/cache
CACHE_VERSION=v6

# Optional residential proxy. Supply through the server's secret manager.
# PROXY_URL=http://user:password@host:port
