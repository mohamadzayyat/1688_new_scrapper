{
  "name": "1688-scraper",
  "version": "1.0.0",
  "description": "Scrape a 1688 product by offer ID and output JSON",
  "type": "module",
  "bin": {
    "1688-scrape": "./cli.js"
  },
  "scripts": {
    "test": "npm run build && npm run test:core && npm run test:mtop && npm run test:extra && npm run test:shop && npm run test:search-http && npm run test:pool && npm run test:queue && npm run test:cache && npm run test:cache:disk && npm run test:translate && npm run test:category && npm run test:compat:local && npm run test:ab:mock",
    "build": "node -e \"console.log('No compile step — plain Node ESM app')\"",
    "start": "node server.js",
    "scrape": "node cli.js",
    "search": "node cli.js --search",
    "login": "node cli.js --login",
    "login:headless": "node scripts/login-headless.js",
    "test:ab": "node scripts/benchmark-ab.js",
    "test:ab:mock": "node scripts/test-ab-benchmark.js",
    "test:compat": "node scripts/test-tmapi-compat.js",
    "test:compat:local": "node scripts/test-local-compat.js",
    "test:cache": "node scripts/test-cache-singleflight.js",
    "test:cache:disk": "node scripts/test-cache-disk.js",
    "test:category": "node scripts/test-category-merge.js",
    "test:core": "node scripts/test-core.js",
    "test:mtop": "node scripts/test-mtop-detail.js",
    "test:extra": "node scripts/test-mtop-extra.js",
    "test:shop": "node scripts/test-shop-http.js",
    "test:search-http": "node scripts/test-search-http.js",
    "test:pool": "node scripts/test-browser-pool.js",
    "test:queue": "node scripts/test-job-queue.js",
    "test:translate": "node scripts/test-translate.js",
    "test:release": "node scripts/test-release-gate.js",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "json5": "2.2.3",
    "playwright": "1.61.1"
  }
}
